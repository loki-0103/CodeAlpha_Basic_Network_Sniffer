# ==============================================================================
# SECURE FLASK APPLICATION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' inside the root or secure_app directory before running:
# cp .env.example secure_app/.env
#
# IMPORTANT: In a production environment, never commit your actual .env file 
# containing production credentials to source control (e.g., Git).
# ==============================================================================

# Strong, cryptographically random secret key for session signing
# Generate using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=9f8e7d6c5b4a3f2e1d0c9b8a7f6e5d4c3b2a1f0e9d8c7b6a5f4e3d2c1b0a9f8e

# Flask Runtime Environment ('development' or 'production')
FLASK_ENV=production

# Flask Debug Mode (Must be False in production)
FLASK_DEBUG=False

# Secure Cookie Enforcement (Set to True if deploying behind HTTPS / SSL)
SESSION_COOKIE_SECURE=False

# Server Port
PORT=5001
HOST=127.0.0.1
